# Bearer token for remote agent snapshot uploads. Optional for local development;
# required by the API when NODE_ENV=production.
# Set the same value as AGENT_ACCESS_TOKEN on the API and the Python agent.
AGENT_ACCESS_TOKEN=replace-with-a-long-random-local-token

# The Replit API server uses its built-in DATABASE_URL environment variable.
# This file contains placeholders only; never commit real credentials.
